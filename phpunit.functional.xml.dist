<?xml version="1.0" encoding="UTF-8"?>
<!--
    The extension on a live phpBB 3.3 board: phpBB's own functional test harness, run from the
    root of a phpBB checkout with the extension at phpBB/ext/minos/moderation/:

        phpBB/vendor/bin/phpunit -c phpBB/ext/minos/moderation/phpunit.functional.xml.dist

    The database and the board's URL come from the environment, as phpBB reads them
    (PHPBB_TEST_DBMS, PHPBB_TEST_DBHOST, ..., PHPBB_FUNCTIONAL_URL). See docs/development.md,
    "The live board"; the CI job is `phpbb-functional` in .github/workflows/tests.yml.
-->
<phpunit backupGlobals="true"
         backupStaticAttributes="false"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         processIsolation="false"
         stopOnFailure="false"
         bootstrap="../../../../tests/bootstrap.php">
    <testsuites>
        <testsuite name="Minos on a live phpBB board">
            <directory suffix="_test.php">./tests/functional/</directory>
        </testsuite>
    </testsuites>
</phpunit>
