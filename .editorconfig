root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# phpBB's coding guidelines indent PHP and templates with tabs.
[*.{php,html}]
indent_style = tab

[{*.yml,*.yaml,*.md,*.json}]
indent_size = 2

[composer.json]
indent_size = 4
